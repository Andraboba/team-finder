DJANGO_SECRET_KEY=change_for_safety
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Вариант 2 использует отдельную базу (см. README)
POSTGRES_DB=teamfinder_var2
POSTGRES_USER=team_finder
POSTGRES_PASSWORD=team_finder
# Для запуска Django на хосте — localhost (внутри docker compose переопределяется на db)
POSTGRES_HOST=localhost
# Порт на хосте, на который пробрасывается PostgreSQL из контейнера
POSTGRES_PORT=5433
